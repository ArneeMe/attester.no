# Firebase web SDK configuration.
# Get these from Firebase Console → Project settings → General → Your apps → SDK setup and configuration.
# For local development, create a SEPARATE Firebase project (not production).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. Only set if your project uses Realtime Database.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
