# Nhost project — from dashboard.
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# Nhost admin secret — for scripts/apply-nhost-config.mjs only. NEVER commit. NEVER expose to client.
# Get from Nhost dashboard → Settings → Hasura → Admin secret.
NHOST_ADMIN_SECRET=

# Nhost JWT signing key — used by /api routes to verify incoming session tokens.
# Get from Nhost dashboard → Settings → Auth → JWT Secret (or the `key` field of NHOST_AUTH_JWT_CUSTOM_CLAIMS).
# Must match the key Nhost uses to sign tokens. Server-only — never expose to client.
NHOST_JWT_SECRET=

# Optional: comma-separated account emails allowed to use the /admin panel
# (create organizations, attach their first member). Unset = /admin disabled.
PLATFORM_ADMIN_EMAILS=

# Optional: email delivery for org member invites (src/lib/server/notify.ts).
# Leave both unset to disable — the invite dialog then just shows the link
# for the admin to share manually.
# RESEND_API_KEY: from resend.com. NOTIFY_EMAIL_FROM: a verified sender,
# e.g. "attester.no <varsel@attester.no>".
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# Optional: push notifications to the platform owner via ntfy
# (src/lib/server/notifyOwner.ts). Unset = no notifications are sent.
# NTFY_TOPIC is the ONLY secret protecting the topic — anyone who learns it can
# read every notification on it, so generate one (`openssl rand -hex 8`) rather
# than picking a memorable name, and treat it like a password. Subscribe in the
# ntfy app to the same topic.
# NTFY_SERVER only needs setting for a self-hosted ntfy; it defaults to
# https://ntfy.sh.
NTFY_TOPIC=
NTFY_SERVER=
