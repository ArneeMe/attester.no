{
  "name": "@attester/api",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@attester/shared": "*",
    "@pdfme/common": "^5.5.8",
    "@pdfme/generator": "^5.5.8",
    "@pdfme/schemas": "^5.5.8",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^25",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
